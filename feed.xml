---
layout: null
permalink: /feed.xml
---
<?xml version="1.0" encoding="UTF-8"?>
<!--
  RSS 2.0, deliberately not Atom: Pinterest's auto-publish supports RSS 2.*
  and 1.* only. Each item carries the hero image as both an enclosure and a
  media:content element, because Pinterest needs an image to build a Pin.
-->
<rss version="2.0"
     xmlns:media="http://search.yahoo.com/mrss/"
     xmlns:atom="http://www.w3.org/2005/Atom">
  <channel>
    <title>{{ site.title | xml_escape }}</title>
    <link>{{ site.url }}{{ site.baseurl }}/</link>
    <atom:link href="{{ site.url }}{{ site.baseurl }}/feed.xml" rel="self" type="application/rss+xml" />
    <description>{{ site.description | strip_newlines | strip | xml_escape }}</description>
    <language>en-us</language>
    <lastBuildDate>{{ site.time | date_to_rfc822 }}</lastBuildDate>

    {%- assign all_guides = site.pages | where: "layout", "article" -%}
    {%- assign dated = all_guides | where_exp: "g", "g.date" | sort: "date" | reverse -%}
    {%- assign undated = all_guides | where_exp: "g", "g.date == nil" -%}
    {%- assign guides = dated | concat: undated -%}
    {%- for guide in guides limit: 20 %}
    <item>
      <title>{{ guide.title | xml_escape }}</title>
      <link>{{ site.url }}{{ site.baseurl }}{{ guide.url }}</link>
      <guid isPermaLink="true">{{ site.url }}{{ site.baseurl }}{{ guide.url }}</guid>
      <description>{{ guide.description | xml_escape }}</description>
      <category>{{ guide.article_tag | xml_escape }}</category>
      {%- if guide.date %}
      <pubDate>{{ guide.date | date_to_rfc822 }}</pubDate>
      {%- endif %}
      {%- if guide.hero_image %}
      <enclosure url="{{ guide.hero_image | xml_escape }}" type="image/jpeg" length="0" />
      <media:content url="{{ guide.hero_image | xml_escape }}" medium="image">
        <media:title>{{ guide.title | xml_escape }}</media:title>
        <media:description>{{ guide.description | xml_escape }}</media:description>
      </media:content>
      {%- endif %}
    </item>
    {%- endfor %}
  </channel>
</rss>
